# TELLO environment configuration example.
# Copy to .env and fill in real values locally. Never commit .env.
# Most Firebase config actually lives in lib/firebase_options.dart
# (generated via `flutterfire configure`), not in this file — this file
# is for values that are NOT safe/appropriate to bake into that generated
# file, such as third-party API keys.

# Google Maps SDK key (Android/iOS), used by the Places screen and
# location pickers.
GOOGLE_MAPS_API_KEY=

# Environment name: development | staging | production
APP_ENV=development

# Optional: base URL override for any Cloud Functions HTTP endpoints.
FUNCTIONS_BASE_URL=
